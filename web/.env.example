# URL of the deployed sync worker (see ../sync-worker/README.md). Leave unset to run
# with browser-local persistence only (no real-time collaboration).
NEXT_PUBLIC_SYNC_URL=
# Required on any deployed host (not localhost). Free hobby key: https://tldraw.dev/get-a-license/hobby
# Either name works; the key is domain-locked and is meant to reach the browser.
TLDRAW_LICENSE_KEY=
